{
  "run_name": "radar-adls-ingestion",
  "timeout_seconds": 600,
  "performance_target": "STANDARD",
  "environments": [{
    "environment_key": "radar-ingestion",
    "spec": {"environment_version": "4", "dependencies": ["openpyxl==3.1.5"]}
  }],
  "tasks": [{
    "task_key": "ingestion",
    "timeout_seconds": 600,
    "environment_key": "radar-ingestion",
    "notebook_task": {
      "notebook_path": "/Shared/radar-macro/notebooks/02_lakehouse",
      "source": "WORKSPACE",
      "base_parameters": {
        "catalog": "radar_adls",
        "repo_root": "/Workspace/Shared/radar-macro"
      }
    }
  }]
}
