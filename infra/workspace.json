{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string", "defaultValue": "francecentral" },
    "workspaceName": { "type": "string", "defaultValue": "dbw-radar-macro-dev" }
  },
  "resources": [
    {
      "type": "Microsoft.Databricks/workspaces",
      "apiVersion": "2026-01-01",
      "name": "[parameters('workspaceName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "premium" },
      "properties": { "computeMode": "Serverless" },
      "tags": { "project": "radar-macro", "environment": "portfolio", "budgetTargetUSD": "35" }
    }
  ]
}
